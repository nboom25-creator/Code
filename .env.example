# Copy this file to .env and fill in your credentials.
# Get paper-trading keys at https://alpaca.markets/ (Paper Trading dashboard).

# Alpaca API credentials
ALPACA_API_KEY=your_paper_key_here
ALPACA_API_SECRET=your_paper_secret_here

# Required ONLY to run in live mode. Leave unset for paper trading.
# To enable live trading you must set this to the exact string below AND set
# `mode: live` in config.yaml. This double confirmation is intentional.
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK
