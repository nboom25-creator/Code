# ==============================================================================
# AegisQuant  (backend/aegisquant)  —  AEGIS_* variables
# ==============================================================================
#
#   cp .env.example .env
#
# The stack runs with only AEGIS_SECRET_KEY and AEGIS_BOOTSTRAP_ADMIN_PASSWORD
# set: the default data provider is a deterministic market simulator and the
# default broker is a simulator, so nothing needs an API key and nothing can
# reach a real account. Each real key you add upgrades one layer.
#
# NEVER commit a filled-in .env. Every value here stays server-side — none of
# these variables is read by the frontend, and no API response returns any of
# them. The browser only ever sees the non-secret subset in
# Settings.public_dict().
#
# The legacy `src/trading_bot` agent lower in this file reads *unprefixed*
# variables. AegisQuant reads only AEGIS_*-prefixed ones, so the two coexist.

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------
# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start outside development with the default value.
AEGIS_SECRET_KEY=

# Password for the bootstrap admin account, created on first start. Change it
# immediately after your first login.
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=
AEGIS_BOOTSTRAP_ADMIN_EMAIL=admin@aegisquant.local

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
# BACKTEST | PAPER | LIVE. LIVE additionally requires AEGIS_LIVE_TRADING_ENABLED
# below plus the in-app activation gate; the platform never falls back from paper
# to live.
AEGIS_MODE=PAPER
# development | test | ci | staging | production
AEGIS_ENV_NAME=development
AEGIS_DEBUG=false
# Display timezone only. Every timestamp is stored in UTC.
AEGIS_TIMEZONE=America/New_York

# ------------------------------------------------------------------------------
# Persistence
# ------------------------------------------------------------------------------
AEGIS_DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegisquant
AEGIS_REDIS_URL=redis://localhost:6379/0
# Log every SQL statement. Very noisy; debugging only.
AEGIS_SQL_ECHO=false

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
AEGIS_ACCESS_TOKEN_TTL_MINUTES=720
# Comma-separated. The Docker Compose stack proxies /api through nginx, so the
# session cookie is first-party and this list only matters for a split deploy.
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AEGIS_RATE_LIMIT_PER_MINUTE=240
# Set to true whenever the app is served over HTTPS.
AEGIS_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Data providers
# ------------------------------------------------------------------------------
# fixture   deterministic simulated market. No key, no network. Every record is
#           flagged synthetic and the UI shows a permanent banner.
# yfinance  free real historical data. Install with: pip install -e ".[providers]"
#           Unofficial, rate-limited, no SLA. Research only, never live.
# alpaca    real data; needs the keys below.
AEGIS_PRICE_PROVIDER=fixture
# fixture | yfinance
AEGIS_FUNDAMENTALS_PROVIDER=fixture
# fixture | alpaca
AEGIS_NEWS_PROVIDER=fixture
# fixture | fred    (fred needs AEGIS_FRED_API_KEY)
AEGIS_MACRO_PROVIDER=fixture
# static | alpaca
AEGIS_CALENDAR_PROVIDER=static

# Seed for the simulator. The same seed always produces the same market, which
# is what makes a failing test reproducible.
AEGIS_FIXTURE_SEED=20240101
AEGIS_PROVIDER_TIMEOUT_SECONDS=20
AEGIS_PROVIDER_MAX_RETRIES=4
AEGIS_PROVIDER_CACHE_TTL_SECONDS=300

# --- Alpaca (paper or live) ----------------------------------------------------
# Paper keys: https://app.alpaca.markets — Paper Trading dashboard. Paper and
# live keys differ; the base URL is chosen by AEGIS_MODE, never guessed.
# AEGIS_ALPACA_KEY_ID=
# AEGIS_ALPACA_SECRET_KEY=

# --- FRED (macroeconomic series) -----------------------------------------------
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# AEGIS_FRED_API_KEY=

# ------------------------------------------------------------------------------
# Broker
# ------------------------------------------------------------------------------
# mock    in-process simulator. Full order lifecycle, partial fills, failure
#         injection. Cannot be used in LIVE mode; the factory refuses it.
# alpaca  real broker. Requires the keys above.
AEGIS_BROKER=mock

# ------------------------------------------------------------------------------
# Live-trading gate — read this whole section before changing anything in it
# ------------------------------------------------------------------------------
# Live trading requires ALL of the following, by design:
#   1. this flag set to true in the server environment
#   2. AEGIS_MODE=LIVE and a backend restart
#   3. a non-mock broker with live credentials
#   4. at least one strategy through the promotion gate (paper track record,
#      out-of-sample results, tracking error within tolerance)
#   5. every preflight check passing
#   6. an explicit UI confirmation plus re-entry of the confirmation phrase
#   7. acknowledgement of the displayed account identifier
# The attempt is recorded in the audit trail whether or not it is granted.
AEGIS_LIVE_TRADING_ENABLED=false
# Change this to something only your operators know.
AEGIS_LIVE_CONFIRMATION_PHRASE=I AUTHORIZE LIVE TRADING
# Hard ceiling on capital the platform may allocate in LIVE mode, in USD. Start
# small: this is a bound on your worst case, not a target.
AEGIS_LIVE_MAX_ALLOCATION_USD=1000
AEGIS_LIVE_REQUIRE_PROMOTION_GATE=true

# ------------------------------------------------------------------------------
# Autonomous loop
# ------------------------------------------------------------------------------
# When false the scheduler stays idle and cycles run only when triggered by hand
# (CLI `loop-once`, or the Execution Monitor). A fresh install should leave this
# false until you have read a few cycles' decisions in the journal.
AEGIS_LOOP_ENABLED=false
AEGIS_LOOP_INTERVAL_SECONDS=900
AEGIS_UNIVERSE_MAX_SYMBOLS=250
AEGIS_BENCHMARK_SYMBOL=SPY
AEGIS_MAX_CANDIDATES_PER_CYCLE=40

# --- Language model (optional) -------------------------------------------------
# Every explanation is generated deterministically from the recorded inputs. When
# this is enabled an LLM may *rewrite* that text for readability, and the rewrite
# is discarded unless its numbers are a subset of the deterministic version. The
# model never decides, sizes, approves, or executes anything.
AEGIS_LLM_ENABLED=false
# AEGIS_ANTHROPIC_API_KEY=
AEGIS_ANTHROPIC_MODEL=claude-sonnet-4-6

# ------------------------------------------------------------------------------
# Risk limits (AEGIS_RISK_*) — enforced by the deterministic risk engine
# ------------------------------------------------------------------------------
# These are the defaults, shown so you know what is in force. An incoherent set
# is rejected at startup rather than run with. An admin can also change them at
# runtime in Settings, which writes a new versioned configuration and keeps the
# previous one.
#
# --- per position ---
# AEGIS_RISK_MAX_POSITION_PCT=0.150
# AEGIS_RISK_MAX_ORDER_NOTIONAL_PCT=0.150
# AEGIS_RISK_MIN_ORDER_NOTIONAL=50
# AEGIS_RISK_MAX_RISK_PER_TRADE_PCT=0.010
#
# --- portfolio ---
# AEGIS_RISK_MAX_GROSS_EXPOSURE_PCT=1.000     # no leverage in v1
# AEGIS_RISK_MAX_NET_EXPOSURE_PCT=1.000
# AEGIS_RISK_MAX_SECTOR_EXPOSURE_PCT=0.350
# AEGIS_RISK_MAX_STRATEGY_EXPOSURE_PCT=0.500
# AEGIS_RISK_MAX_CORRELATED_EXPOSURE_PCT=0.500
# AEGIS_RISK_CORRELATION_THRESHOLD=0.600
# AEGIS_RISK_MAX_OPEN_POSITIONS=15
# AEGIS_RISK_MIN_CASH_BUFFER_PCT=0.020
#
# --- loss limits and the defensive ladder (must increase in this order) ---
# AEGIS_RISK_MAX_DAILY_LOSS_PCT=0.030         # halts trading for the session
# AEGIS_RISK_MAX_WEEKLY_LOSS_PCT=0.070
# AEGIS_RISK_MAX_PORTFOLIO_DRAWDOWN_PCT=0.200
# AEGIS_RISK_DRAWDOWN_WARNING_PCT=0.070       # new sizes reduced by a quarter
# AEGIS_RISK_DEFENSIVE_STAGE_1_PCT=0.100      # new sizes halved
# AEGIS_RISK_DEFENSIVE_STAGE_2_PCT=0.150      # no new entries
# AEGIS_RISK_EMERGENCY_STAGE_PCT=0.200        # human approval to resume
# AEGIS_RISK_LOSS_COOLDOWN_HOURS=24
#
# --- execution and microstructure ---
# AEGIS_RISK_MAX_TURNOVER_DAILY_PCT=0.500
# AEGIS_RISK_MIN_ADV_USD=5000000
# AEGIS_RISK_MAX_ADV_PARTICIPATION_PCT=0.010
# AEGIS_RISK_MAX_ESTIMATED_IMPACT_BPS=50
# AEGIS_RISK_MAX_SPREAD_BPS=50
# AEGIS_RISK_MIN_PRICE=5
# AEGIS_RISK_MAX_DATA_AGE_SECONDS=900
# AEGIS_RISK_MAX_OPEN_ORDER_SECONDS=3600
#
# --- sizing ---
# Fractional Kelly only. Anything above 0.5 is rejected by validation: full
# Kelly maximises growth only under a perfectly known edge, and every edge here
# is an estimate with material error.
# AEGIS_RISK_KELLY_FRACTION=0.250
# AEGIS_RISK_TARGET_PORTFOLIO_VOL_PCT=0.180
# AEGIS_RISK_CONVICTION_SIZE_FLOOR=0.250

# ------------------------------------------------------------------------------
# Promotion gate (AEGIS_PROMO_*) — paper to live-eligible
# ------------------------------------------------------------------------------
# AEGIS_PROMO_MIN_PAPER_DAYS=60
# AEGIS_PROMO_MIN_PAPER_TRADES=30
# AEGIS_PROMO_MIN_OOS_SHARPE=0.80
# AEGIS_PROMO_MAX_OOS_DRAWDOWN=0.250
# AEGIS_PROMO_MIN_BENCHMARK_EXCESS=0.000
# AEGIS_PROMO_MAX_PAPER_SIM_TRACKING_ERROR=0.500
# AEGIS_PROMO_REQUIRE_ZERO_OPEN_DATA_ISSUES=true
# AEGIS_PROMO_REQUIRE_ZERO_OPEN_RECON_BREAKS=true

# ------------------------------------------------------------------------------
# Docker Compose only
# ------------------------------------------------------------------------------
# POSTGRES_PASSWORD=aegis
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BACKEND_PORT=8000
# FRONTEND_PORT=5173


# ==============================================================================
# Legacy agent  (src/trading_bot)  —  unprefixed variables
# ==============================================================================
# The original single-file autonomous agent that predates AegisQuant. Kept
# working and unchanged; ignore this whole section if you only run AegisQuant.

# Copy this file to .env and fill in what you have. The dry-run works with NONE
# of these set (free yfinance data + simulated paper account + offline analyst);
# each key you add upgrades the run. Never commit your real .env.
#
#   cp .env.example .env

# --- LLM brain (optional) --------------------------------------------------
# If set, the agent's Research-then-Decide loop is driven by Claude.
# If unset (or with --offline), a deterministic local HeuristicLLM is used.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Alpaca paper trading (optional) ---------------------------------------
# Paper-trading keys from https://alpaca.markets/ (Paper Trading dashboard).
# If set, get_portfolio_state reads your real paper account. If unset, a
# simulated $100k paper account is used. The dry-run never sends orders either way.
# ALPACA_API_KEY=your_paper_key_here
# ALPACA_API_SECRET=your_paper_secret_here
# Optional endpoint override (defaults to the paper endpoint).
# ALPACA_API_BASE_URL=https://paper-api.alpaca.markets

# --- Robinhood agentic trading (optional, alternative to Alpaca) ------------
# Only used when config.yaml has `broker: robinhood`. Endpoint is published
# (https://agent.robinhood.com/mcp/trading) and used by default — no URL needed.
# Auth is an interactive OAuth login (Robinhood's "authenticate" step), handled
# by the MCP client, so there's normally no static token to set here. NOTE: this
# is a real-money account with no paper sandbox; requires `pip install mcp`. The
# integration is scaffolded but not yet wired to live orders — see
# src/trading_bot/robinhood.py for what still needs Robinhood's MCP tool spec.
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading   # override only
# ROBINHOOD_MCP_TOKEN=...                                      # fallback only

# --- Alternative research for small/micro-caps (optional) ------------------
# Stock screener + fundamentals (https://financialmodelingprep.com/).
# FMP_API_KEY=your_fmp_key
# Targeted web scraping for niche/regional coverage (https://firecrawl.dev/).
# FIRECRAWL_API_KEY=fc-...
# SEC EDGAR is free and needs no key, but SEC asks for a descriptive User-Agent
# with contact info (used for 10-Q/10-K and Form 4 insider lookups).
# SEC_EDGAR_USER_AGENT=Your Name your@email.com

# --- Notifications (optional) ----------------------------------------------
# Slack or Discord incoming-webhook URL for trade / daily-P&L / halt alerts.
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Live trading safety (leave unset for paper) ---------------------------
# Required ONLY to run the live engine with real money, together with
# `mode: live` in config.yaml. Intentionally a two-key confirmation.
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK
