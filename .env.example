# Copy to .env (backend reads it at startup). All variables are optional.

# development | production  (production never returns mock analysis results)
PARTFORGE_ENVIRONMENT=development

# Database: SQLite file under data/ by default; set for PostgreSQL:
# PARTFORGE_DATABASE_URL=postgresql+psycopg2://partforge:partforge@localhost:5432/partforge

# Upload limits
PARTFORGE_MAX_UPLOAD_BYTES=104857600
PARTFORGE_MAX_TRIANGLES=2000000

# FEA
PARTFORGE_CCX_PATH=ccx
PARTFORGE_FEA_TIMEOUT_S=600
PARTFORGE_FEA_MEMORY_LIMIT_MB=4096
PARTFORGE_FEA_TARGET_ELEMENTS=60000

# Background workers
PARTFORGE_WORKER_THREADS=2

# AI provider: rules (local, default) | mock | openai | anthropic
PARTFORGE_AI_PROVIDER=rules
# PARTFORGE_OPENAI_API_KEY=
# PARTFORGE_ANTHROPIC_API_KEY=
