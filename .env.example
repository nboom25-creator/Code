# ProjectPath environment configuration
#
# The app runs fully in DEMO MODE with no configuration at all:
# seed projects load from local data and all user progress, shopping
# lists and notes persist to the browser's localStorage.
#
# To enable real authentication and cloud sync, create a Supabase project
# (https://supabase.com) and fill in the values below. Only the two
# NEXT_PUBLIC_* values are ever exposed to the browser. The service role
# key is server-only and must never be prefixed with NEXT_PUBLIC_.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the client. Used for admin/seed scripts only.
SUPABASE_SERVICE_ROLE_KEY=
