# GliderForge Assistant - environment configuration
# Copy to .env.local and edit. Never commit .env.local.

# SQLite database file (created automatically on first run).
GLIDERFORGE_DB=./data/gliderforge.db

# Directory for uploaded geometry/datasheet files.
GLIDERFORGE_UPLOAD_DIR=./data/uploads

# Max upload size in bytes (default 25 MB).
GLIDERFORGE_MAX_UPLOAD_BYTES=26214400

# --- Optional AI provider -------------------------------------------------
# If unset, the app uses the built-in deterministic rules-based assistant.
# Supported: "local" (default) | "anthropic"
ASSISTANT_PROVIDER=local
# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
