# StockCast backend configuration.
# Copy to `.env` and fill in as needed. API keys are read server-side only and
# are never exposed to the browser.

# Active market-data provider: twelvedata | stooq | alphavantage | finnhub | demo
#   twelvedata   - REAL-TIME quotes + 5y history + fundamentals in one free key
#                  (recommended for live data; free tier ~800 req/day, 8/min)
#   stooq        - real end-of-day data, NO API KEY required (default; not real-time)
#   alphavantage - real data incl. fundamentals & news (free key, ~25 req/day)
#   finnhub      - real-time quotes/fundamentals/news (history needs paid plan)
#   demo         - synthetic DEMO DATA, works fully offline (clearly labelled)
#
# For REAL-TIME data set PROVIDER=twelvedata and add TWELVEDATA_API_KEY below.
PROVIDER=stooq

# API keys (only needed for the matching provider).
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=

# When a real provider is unconfigured/unreachable, fall back to labelled DEMO
# DATA instead of erroring. Set to false to force explicit setup errors.
ALLOW_DEMO_FALLBACK=true

# Cache TTLs (seconds).
CACHE_TTL_HISTORY_SECONDS=21600
CACHE_TTL_QUOTE_SECONDS=60
CACHE_TTL_FUNDAMENTALS_SECONDS=86400
CACHE_DB_PATH=stockcast_cache.sqlite

# Outbound HTTP behaviour.
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3

# Comma-separated CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
