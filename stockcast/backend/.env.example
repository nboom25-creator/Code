# StockCast backend configuration.
# Copy to `.env` and fill in as needed. API keys are read server-side only and
# are never exposed to the browser.

# Active market-data provider: stooq | alphavantage | finnhub | demo
#   stooq        - real end-of-day data, NO API KEY required (default)
#   alphavantage - real data incl. fundamentals & news (free key, rate limited)
#   finnhub      - real quotes/fundamentals/news (history needs paid plan)
#   demo         - synthetic DEMO DATA, works fully offline (clearly labelled)
PROVIDER=stooq

# API keys (only needed for the matching provider).
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=

# When a real provider is unconfigured/unreachable, fall back to labelled DEMO
# DATA instead of erroring. Set to false to force explicit setup errors.
ALLOW_DEMO_FALLBACK=true

# Cache TTLs (seconds).
CACHE_TTL_HISTORY_SECONDS=21600
CACHE_TTL_QUOTE_SECONDS=60
CACHE_TTL_FUNDAMENTALS_SECONDS=86400
CACHE_DB_PATH=stockcast_cache.sqlite

# Outbound HTTP behaviour.
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3

# Comma-separated CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
